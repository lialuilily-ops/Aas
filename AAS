<div class="app-container">
  <!-- Top Safety Bar with Vector Logo -->
  <div class="top-bar">
    <div class="brand-logo-group">
      <div class="logo-icon">
        <!-- Embedded SVG Heart & Hope Logo -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
        </svg>
      </div>
      <div class="brand-text">Aas <span class="brand-urdu">آس</span></div>
    </div>
    <button class="quick-exit" onclick="quickExit()">Quick Exit ✕</button>
  </div>

  <!-- Hero Header -->
  <div class="hero-banner">
    <h1>Mental Health & Crisis Directory</h1>
    <p>Confidential, free, and immediate support across Pakistan.</p>
  </div>

  <!-- Immediate SOS Bar -->
  <div class="sos-bar">
    <span>🚨 In immediate danger or severe distress?</span>
    <a href="tel:03117786264" class="sos-btn">Call 24/7 Crisis Line</a>
  </div>

  <!-- Search & Dynamic Category Filters -->
  <div class="controls">
    <div class="search-wrapper">
      <span class="search-icon">🔍</span>
      <input type="text" id="searchInput" class="search-box" placeholder="Search by name, topic, or language..." oninput="filterData()">
    </div>
    
    <div class="results-count">
      <span>Categories</span>
      <span id="counterText">Showing 5 helplines</span>
    </div>

    <div class="filter-pills">
      <button class="pill active" onclick="setCategory('All', this)">All</button>
      <button class="pill" onclick="setCategory('Crisis', this)">Crisis</button>
      <button class="pill" onclick="setCategory('Counseling', this)">Counseling</button>
      <button class="pill" onclick="setCategory('Women & Youth', this)">Women & Youth</button>
      <button class="pill" onclick="setCategory('Addiction', this)">Addiction</button>
    </div>
  </div>

  <!-- Helpline Cards List -->
  <div class="helpline-list" id="helplineContainer">
    <!-- Rendered via JavaScript -->
  </div>

  <div class="footer-note">
    Created by <strong>Luiza Arif</strong> • Confidential Public Welfare Directory<br>
    <em>Aas does not collect or store personal user data.</em>
  </div>
</div>

<script>
  const helplines = [
    {
      name: "Umang Pakistan",
      category: "Crisis",
      phone: "03117786264",
      hours: "24/7",
      is247: true,
      languages: "Urdu, English",
      desc: "24/7 mental health crisis support and suicide prevention helpline.",
      whatsapp: "https://wa.me/923117786264"
    },
    {
      name: "Taskeen Helpline",
      category: "Counseling",
      phone: "03321827533",
      hours: "9 AM - 5 PM",
      is247: false,
      languages: "Urdu, English",
      desc: "Emotional well-being, psychological counseling, and wellness support.",
      whatsapp: ""
    },
    {
      name: "Rozan Helpline",
      category: "Women & Youth",
      phone: "080022444",
      hours: "10 AM - 6 PM",
      is247: false,
      languages: "Urdu, Regional",
      desc: "Support for women, youth, and children experiencing emotional distress.",
      whatsapp: ""
    },
    {
      name: "AAS Trust Pakistan",
      category: "Addiction",
      phone: "02135873215",
      hours: "9 AM - 6 PM",
      is247: false,
      languages: "Urdu, English",
      desc: "Rehabilitation and psychological recovery for addiction.",
      whatsapp: ""
    },
    {
      name: "Chayn Pakistan",
      category: "Women & Youth",
      phone: "03008253131",
      hours: "24/7",
      is247: true,
      languages: "Urdu, English",
      desc: "Crisis support and legal/counseling guidance for women.",
      whatsapp: ""
    }
  ];

  let selectedCategory = "All";

  function renderCards(data) {
    const container = document.getElementById("helplineContainer");
    const counter = document.getElementById("counterText");
    container.innerHTML = "";

    counter.textContent = `Showing ${data.length} helpline${data.length === 1 ? '' : 's'}`;

    if (data.length === 0) {
      container.innerHTML = '<div style="text-align:center; color:#64748b; padding:30px; font-size:14px;">No matching helplines found.<br><small>Try searching with another keyword.</small></div>';
      return;
    }

    data.forEach(item => {
      const card = document.createElement("div");
      card.className = "card";
      
      const waButton = item.whatsapp 
        ? `<a href="${item.whatsapp}" target="_blank" class="btn btn-wa">💬 WhatsApp</a>` 
        : '';

      const hoursBadgeClass = item.is247 ? 'meta-badge meta-247' : 'meta-badge';

      card.innerHTML = `
        <div class="card-header">
          <div class="card-title">${item.name}</div>
          <span class="badge-category">${item.category}</span>
        </div>
        <div class="card-info">${item.desc}</div>
        <div class="meta-row">
          <div class="${hoursBadgeClass}">🕒 ${item.hours}</div>
          <div class="meta-badge">🗣️ ${item.languages}</div>
        </div>
        <div class="btn-group">
          <a href="tel:${item.phone}" class="btn btn-call">📞 Call ${item.phone}</a>
          ${waButton}
          <button class="btn btn-copy" onclick="copyNumber('${item.phone}', this)" title="Copy Phone Number">📋</button>
        </div>
      `;
      container.appendChild(card);
    });
  }

  function filterData() {
    const query = document.getElementById("searchInput").value.toLowerCase();
    const filtered = helplines.filter(item => {
      const matchesSearch = item.name.toLowerCase().includes(query) || 
                            item.desc.toLowerCase().includes(query) || 
                            item.languages.toLowerCase().includes(query);
      const matchesCategory = selectedCategory === "All" || item.category === selectedCategory;
      return matchesSearch && matchesCategory;
    });
    renderCards(filtered);
  }

  function setCategory(cat, btn) {
    selectedCategory = cat;
    document.querySelectorAll(".pill").forEach(p => p.classList.remove("active"));
    btn.classList.add("active");
    filterData();
  }

  function copyNumber(phone, btnElement) {
    navigator.clipboard.writeText(phone).then(() => {
      const originalText = btnElement.innerHTML;
      btnElement.innerHTML = '✅';
      setTimeout(() => { btnElement.innerHTML = originalText; }, 1500);
    });
  }

  function quickExit() {
    window.location.href = "https://www.google.com";
  }

  // Initial render
  renderCards(helplines);
</script>

</body>
